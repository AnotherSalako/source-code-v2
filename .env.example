# Copy to .env and fill in. Never commit the real .env file.

PORT=4000

# --- Supabase Postgres (project: "demi" / rwrkimrznijzxcuaudbd) ---
# Get this from: Supabase dashboard -> Project Settings -> Database ->
# Connection string ("Transaction" pooler works well for this app). The MCP
# tooling used to provision the project cannot read back the DB password —
# you set/reset it in the dashboard and paste the full URL here.
DATABASE_URL="postgresql://postgres.rwrkimrznijzxcuaudbd:<db-password>@aws-0-eu-west-2.pooler.supabase.com:6543/postgres"

# --- Clerk (identity, credentials, MFA, sessions — see src/middleware/auth.ts) ---
# Clerk dashboard -> API Keys. Publishable key is safe to expose client-side;
# secret key is server-only, never commit it, never send it to a browser.
CLERK_PUBLISHABLE_KEY="pk_test_replace-with-your-key"
CLERK_SECRET_KEY="sk_test_replace-with-your-key"

# --- Object storage for encrypted evidence/report files ---
# "supabase" (default) uploads ciphertext to a private Supabase Storage bucket.
# "local" writes ciphertext to STORAGE_DIR instead (offline dev/tests only).
STORAGE_BACKEND="supabase"
STORAGE_DIR="./storage"

# Project URL: https://rwrkimrznijzxcuaudbd.supabase.co
SUPABASE_URL="https://rwrkimrznijzxcuaudbd.supabase.co"
# service_role secret key — Supabase dashboard -> Project Settings -> API.
# Bypasses storage RLS; NEVER expose this to a browser/mobile client, never
# commit it. Cannot be fetched through the Supabase MCP tools by design.
SUPABASE_SERVICE_ROLE_KEY="replace-with-the-service-role-key"
SUPABASE_STORAGE_BUCKET="jupiter-evidence"

# --- Key management: "local" (default, dev-only) or "aws" (real KMS) ---
KMS_PROVIDER="local"

# Local-dev KMS stand-in (see src/crypto/kms.ts) — only used when
# KMS_PROVIDER=local. DO NOT reuse this pattern in production. Generate a
# 32-byte key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CMK_BASE64="replace-with-a-base64-32-byte-key"
CMK_ID="local-cmk"
CMK_VERSION=1

# Real AWS KMS (src/crypto/providers/aws-kms.ts) — only used when
# KMS_PROVIDER=aws. The execution role needs exactly kms:GenerateDataKey and
# kms:Decrypt on this key ARN, nothing else (see the file for why).
# AWS_REGION="eu-west-2"
# AWS_KMS_KEY_ID="arn:aws:kms:eu-west-2:123456789012:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# AWS_KMS_KEY_VERSION=1

# Shared secret the scheduled key-rotation endpoint checks for. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Required only if you wire up scheduled rotation (see vercel.json "crons"
# and src/modules/internal/rotation.routes.ts).
# CRON_SECRET="replace-with-a-long-random-value"

# --- Website scanning (src/modules/scanning) ---
# Requires the Nuclei binary (https://nuclei.projectdiscovery.io/) reachable
# on whatever host runs this process — not usable on Vercel's serverless
# runtime (no persistent binary, execution-time limits). Defaults to
# expecting "nuclei" on PATH; set an explicit path if it isn't.
# NUCLEI_BIN_PATH="nuclei"
# Safety default: automated scans refuse targets resolving to a private/
# loopback/link-local address, so a bad asset URL can't turn this into an
# SSRF probe of your own network. Only set true for local dev/demo use
# against your own machine (e.g. scanning 127.0.0.1).
# ALLOW_INTERNAL_SCAN_TARGETS=false

# --- Malware detection (src/integrations/virustotal.ts) ---
# Optional. Unset means every check reports "unavailable" rather than
# failing anything. Free tier: https://www.virustotal.com/gui/join-us
# VIRUSTOTAL_API_KEY="replace-with-your-key"

# --- AI-assisted triage (src/ai) ---
# "noop" (default) drafts nothing. "anthropic" calls the Claude Messages API
# to draft remediation guidance + a false-positive likelihood per finding —
# always advisory, never auto-applied to the real remediationGuidance/status
# (see README "AI-assisted triage").
# AI_TRIAGE_PROVIDER="noop"
# ANTHROPIC_API_KEY="replace-with-your-key"
# AI_TRIAGE_MODEL="claude-sonnet-5"

# --- Active response (src/threat-response) ---
# "noop" (default) takes no action and says so. "crowdstrike" calls the
# real Falcon API to request host network containment — always triggered by
# a human clicking a button, never automatic. Untested against a live
# CrowdStrike account (see README "Malware detection & active response").
# THREAT_RESPONSE_PROVIDER="noop"
# CROWDSTRIKE_CLIENT_ID="replace-with-your-client-id"
# CROWDSTRIKE_CLIENT_SECRET="replace-with-your-client-secret"
# CROWDSTRIKE_BASE_URL="https://api.crowdstrike.com"

# --- E-signature (src/esignature) ---
# "noop" (default) means the authorization gate stays manual/self-attested
# (POST /engagements/:id/authorize). "documenso" sends the ROE out for a
# real, verified signature instead — the gate only opens once the provider
# itself confirms it's signed. Untested against a live Documenso account,
# and Documenso's v2 API is itself still in beta (see
# src/esignature/providers/documenso.ts for exactly what's confirmed vs.
# inferred from their public docs).
# ESIGNATURE_PROVIDER="noop"
# DOCUMENSO_API_KEY="replace-with-your-key"

# --- Notifications (src/notifications) ---
# Fan-out, not a single provider choice — any combination is valid,
# including neither. A CRITICAL/HIGH finding from any creation path
# (manual, bulk import, automated/scheduled scan) triggers whichever of
# these are configured.
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/replace/with/yours"
# RESEND_API_KEY="replace-with-your-key"
# NOTIFICATION_EMAIL_FROM="alerts@yourdomain.com"
# NOTIFICATION_EMAIL_TO="security-team@yourdomain.com"
