// Jupiter — one-time cybersecurity assessment platform
// Data model mirrors the design doc. Fields suffixed `Enc` hold an
// EncryptedField JSON blob (ciphertext/iv/authTag/encryptedDataKey/keyId/keyVersion)
// produced by src/crypto/envelope.ts — never plaintext.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (Windows/Mac/whatever). rhel-openssl-3.0.x is
  // required for Vercel specifically — its serverless Node runtime doesn't
  // reliably match the exact binary produced during the build step, and
  // without this target the query engine fails to load at cold start
  // (surfaces as a generic "Serverless Function has crashed" 500, not a
  // helpful Prisma error, since it happens at PrismaClient construction
  // time in src/db/prisma.ts, before any request-level error handling runs).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EXEC_CLIENT
  TECHNICAL_CLIENT
  SECURITY_ADMIN
}

enum EngagementStatus {
  SCOPING
  ACTIVE
  REPORTING
  RETEST
  CLOSED
}

enum AssetType {
  WEB
  MOBILE
  SERVER
  CLOUD
  NETWORK
  API
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TestType {
  VULN_SCAN
  PENTEST
  COMPLIANCE_REVIEW
}

enum TestStatus {
  PLANNED
  IN_PROGRESS
  COMPLETE
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  REMEDIATING
  RETESTED_PASS
  RETESTED_FAIL
  ACCEPTED_RISK
}

enum ComplianceFramework {
  NDPR
  ISO27001
  PCI_DSS
  OTHER
}

enum ComplianceStatus {
  PENDING // loaded from a standard control library, not yet assessed
  PASS
  FAIL
  PARTIAL
  NOT_APPLICABLE
}

enum RemediationEffort {
  QUICK_WIN
  SMALL
  MEDIUM
  LARGE
}

enum FalsePositiveLikelihood {
  LOW
  MEDIUM
  HIGH
}

enum TrainingTopic {
  PHISHING
  PASSWORD_HYGIENE
  DATA_HANDLING
  APP_INFRA_MISTAKES
  CUSTOM
}

enum TrainingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ReportType {
  EXECUTIVE
  TECHNICAL
  RETEST_ADDENDUM
}

enum RetestResult {
  FIXED
  NOT_FIXED
  PARTIALLY_FIXED
}

enum KeyPurpose {
  DB_FIELD
  FILE
}

enum KeyStatus {
  ACTIVE
  RETIRED
  REVOKED
}

enum AuditAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  DOWNLOAD
  DECRYPT
  LOGIN
  LOGIN_FAILED
}

enum AuditResult {
  SUCCESS
  DENIED
}

enum VerificationMethod {
  DNS_TXT
  HTTP_FILE
  MANUAL // security_admin attests authorization out-of-band (e.g. infra already covered by a signed ROE) — logged with a justification
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum ScanJobStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED
}

enum DiscoveredAssetStatus {
  NEW      // surfaced by a discovery run, not yet reviewed
  PROMOTED // a human turned it into a real Asset (still UNVERIFIED until it passes ownership verification separately)
  IGNORED  // a human reviewed it and chose not to act on it
}

enum MalwareStatus {
  PENDING     // check not run yet (or still in flight)
  CLEAN       // VirusTotal has analyzed this hash/URL and no engine flagged it
  FLAGGED     // one or more engines flagged it — see malwareDetections
  UNAVAILABLE // no verdict: VIRUSTOTAL_API_KEY unset, hash/URL unknown to VT, or a lookup error — NOT the same as CLEAN
}

enum AuthorizationMethod {
  MANUAL     // security_admin self-attests a paper/out-of-band-signed doc — always available, no provider required
  ESIGNATURE // sent through an ESignatureProvider and confirmed via its own verified status, not self-attested
}

enum AuthorizationRequestStatus {
  SENT
  SIGNED
  DECLINED
  VOIDED
}

// Identity and credentials (password, MFA, sessions) live in Clerk, not here.
// This table is the authorization side only — role/orgId — resolved by
// looking up the Clerk-verified request's email address against `email`
// (see src/middleware/clerk-auth.ts). A row must exist here before someone
// who's signed up in Clerk can do anything in the app.
model User {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  role        Role
  orgId       String? // clients.id for client-side users; null for internal staff
  org         Client?   @relation(fields: [orgId], references: [id])
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())

  auditLogs AuditLog[]

  @@index([orgId])
}

model Client {
  id                String   @id @default(uuid())
  name              String
  industry          String?
  primaryContactEnc Json? // EncryptedField
  billingInfoEnc    Json? // EncryptedField
  createdAt         DateTime @default(now())

  // Per-tenant encryption key (src/crypto/tenant.ts) — null means this
  // client's data still encrypts under the shared system CMK, same as
  // every client before this feature existed; assigning one via
  // PATCH /clients/:id/kms-key moves NEW encryptions for this client onto
  // a key no other tenant's data is ever wrapped by. Already-encrypted
  // records keep decrypting correctly regardless (EncryptedField.kmsKeyId
  // travels with each record, same mechanism key rotation already relies
  // on) — assigning a key is not a forced re-encryption.
  kmsKeyId String?

  users            User[]
  engagements      Engagement[]
  devices          Device[]
  enrollmentTokens EnrollmentToken[]
}

model Engagement {
  id                    String           @id @default(uuid())
  clientId              String
  client                Client           @relation(fields: [clientId], references: [id])
  status                EngagementStatus @default(SCOPING)
  scopeDocRef           String? // object storage key, file itself encrypted at rest
  assumptionsEnc        Json? // EncryptedField
  exclusionsEnc         Json? // EncryptedField
  authorizedBy          String?
  authorizationSignedAt DateTime?
  authorizationDocRef   String? // object storage key — encryption metadata below, only set once actually stored (e-signature path)
  authorizationDocIv               String?
  authorizationDocAuthTag          String?
  authorizationDocEncryptedDataKey String?
  authorizationDocKmsKeyId         String?
  authorizationDocKeyVersion       Int?

  // E-signature workflow (src/esignature) — populated once "send" is
  // called; authorizationSignedAt/authorizedBy/authorizationDocRef above
  // only get set once a "check" confirms the provider actually reports it
  // signed, same hard gate as the MANUAL path, just verified instead of
  // self-attested.
  authorizationMethod        AuthorizationMethod?
  authorizationEnvelopeId    String?
  authorizationRequestStatus AuthorizationRequestStatus?
  startDate             DateTime?
  endDate               DateTime?
  createdAt             DateTime         @default(now())

  assets           Asset[]
  tests            Test[]
  complianceChecks ComplianceCheck[]
  reports          Report[]
  trainingSessions TrainingSession[]
  scanJobs         ScanJob[]
  discoveryJobs    DiscoveryJob[]
  discoveredAssets DiscoveredAsset[]
  watchAlerts      WatchAlert[]

  @@index([clientId])
}

model Asset {
  id            String      @id @default(uuid())
  engagementId  String
  engagement    Engagement  @relation(fields: [engagementId], references: [id])
  type          AssetType
  name          String
  identifierEnc Json // EncryptedField — IP/hostname/URL
  owner         String?
  criticality   Criticality @default(MEDIUM)
  inScope       Boolean     @default(true)
  notesEnc      Json? // EncryptedField
  createdAt     DateTime    @default(now())

  // Automated scanning (POST .../scan) refuses to run against a WEB/API asset
  // until this is VERIFIED — proves whoever requested the scan actually
  // controls the target, not just that they typed a URL into a form. See
  // src/modules/assets/verification.ts.
  verificationStatus VerificationStatus  @default(UNVERIFIED)
  verificationMethod VerificationMethod?
  verificationToken  String? // random value the client publishes (DNS TXT record or well-known file) to prove control
  verifiedAt         DateTime?
  verifiedBy         String? // User.id who confirmed it (the admin who ran the check, or approved the manual override)

  tests            Test[]
  findings         Finding[]
  scanJobs         ScanJob[]
  discoveryJobs    DiscoveryJob[]    // discovery runs launched from this (VERIFIED) asset
  discoveredAssets DiscoveredAsset[] // candidates surfaced under this asset, pending review

  @@index([engagementId])
}

model Test {
  id           String     @id @default(uuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id])
  assetId      String
  asset        Asset      @relation(fields: [assetId], references: [id])
  type         TestType
  methodology  String?
  toolUsed     String?
  testerId     String?
  status       TestStatus @default(PLANNED)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())

  findings Finding[]
  scanJobs ScanJob[]

  @@index([engagementId])
  @@index([assetId])
}

// One row per automated scan run (POST /engagements/:id/assets/:assetId/scan).
// Distinct from Test/Finding: a ScanJob tracks the *run itself* (which tool,
// how long, did it error) so the dashboard can show live progress, while its
// results land as ordinary Findings via the same import path used for manual
// JSONL uploads (src/modules/findings/import.service.ts) — dedup, roadmap,
// reporting all just work without knowing scans can be triggered in-app.
model ScanJob {
  id           String        @id @default(uuid())
  engagementId String
  engagement   Engagement    @relation(fields: [engagementId], references: [id])
  assetId      String
  asset        Asset         @relation(fields: [assetId], references: [id])
  testId       String?
  test         Test?         @relation(fields: [testId], references: [id])
  tool         String        @default("nuclei")
  status       ScanJobStatus @default(QUEUED)
  triggeredById String
  startedAt     DateTime?
  completedAt   DateTime?
  errorMessage  String?
  findingsCreated Int?
  findingsSkipped Int?
  rawResultEnc    Json? // EncryptedField — full scanner JSONL output, kept for audit/evidence even though every item is also normalized into Findings
  createdAt       DateTime      @default(now())

  @@index([engagementId])
  @@index([assetId])
  @@index([status])
}

// One run of attack-surface discovery (POST .../assets/:assetId/discover)
// against a single, already-VERIFIED root asset — same ownership gate
// scanning uses, for the same reason: querying certificate-transparency
// logs and connect-probing whatever resolves is still directed at a target,
// and "prove you control it first" is what keeps that from being an open
// abuse primitive. Deliberately passive/non-intrusive: a CT-log lookup plus
// a connect-only check against a small well-known port list, no brute
// forcing of hostnames and no exploitation. Results land as DiscoveredAsset
// rows for a human to review — never auto-promoted into scannable Assets,
// mirroring the human-gated pattern used everywhere else in this codebase.
model DiscoveryJob {
  id              String        @id @default(uuid())
  engagementId    String
  engagement      Engagement    @relation(fields: [engagementId], references: [id])
  assetId         String
  asset           Asset         @relation(fields: [assetId], references: [id])
  tool            String        @default("passive-discovery")
  status          ScanJobStatus @default(QUEUED) // same lifecycle as ScanJob — reused rather than duplicated
  triggeredById   String
  startedAt       DateTime?
  completedAt     DateTime?
  errorMessage    String?
  discoveredCount Int?
  createdAt       DateTime      @default(now())

  watchAlerts WatchAlert[]

  discoveredAssets DiscoveredAsset[]

  @@index([engagementId])
  @@index([assetId])
  @@index([status])
}

// A candidate asset a DiscoveryJob surfaced (subdomain, plus which of a
// small common-port list answered a plain TCP connect) — not a real Asset
// until a human promotes it. `valueEnc` follows the same EncryptedField
// convention as Asset.identifierEnc; dedup against previously-discovered
// values happens in application code (src/modules/discovery), same as
// finding-dedup in src/modules/findings/import.service.ts, since ciphertext
// can't be compared/uniqued directly.
model DiscoveredAsset {
  id              String                @id @default(uuid())
  engagementId    String
  engagement      Engagement            @relation(fields: [engagementId], references: [id])
  parentAssetId   String
  parentAsset     Asset                 @relation(fields: [parentAssetId], references: [id])
  discoveryJobId  String
  discoveryJob    DiscoveryJob          @relation(fields: [discoveryJobId], references: [id])
  valueEnc        Json // EncryptedField — discovered hostname
  source          String // e.g. "crt.sh"
  openPorts       Int[]                 @default([]) // port numbers only — kept for backward compatibility with the original connect-only check
  portDetails     Json? // [{ port, protocol, service, version }] from Nmap -sV (src/modules/discovery/nmap.ts); null if Nmap wasn't reachable when this ran
  status          DiscoveredAssetStatus @default(NEW)
  promotedAssetId String? // Asset.id created on promote — plain string, no relation, same convention as Asset.verifiedBy/ScanJob.triggeredById
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime              @default(now())

  // Set on the original discovery run and every subsequent watch cycle —
  // null means "never re-checked since first discovered," not an error.
  // Watch mode (src/modules/discovery/watch-runner.ts) is what actually
  // updates openPorts/portDetails on an *existing* row after the first
  // discovery run; ordinary discovery (discovery-runner.ts) deliberately
  // never revisits a hostname it's already seen, so without watch mode
  // this field would just sit at its initial value forever.
  lastScannedAt DateTime?

  watchAlerts WatchAlert[]

  @@index([engagementId])
  @@index([parentAssetId])
  @@index([status])
}

enum WatchAlertKind {
  NEW_SUBDOMAIN // a watch cycle's crt.sh sweep found a hostname never seen before under this root asset
  PORT_OPENED
  PORT_CLOSED
  SERVICE_CHANGED // same port, different service/version banner than last time
}

// A detected change on an already-known asset — deliberately NOT a Finding.
// Finding requires a Test (pentest-workflow shape: severity, CVSS,
// remediation guidance, retest lifecycle) and dedups on assetId+title: none
// of that fits "port 8080 opened since yesterday," which is a fact about
// drift, not a vulnerability assessment. A human reviewing this can decide
// it warrants a real Finding and create one the normal way; watch mode
// itself only ever surfaces the change.
model WatchAlert {
  id                String           @id @default(uuid())
  engagementId      String
  engagement        Engagement       @relation(fields: [engagementId], references: [id])
  discoveredAssetId String?
  discoveredAsset   DiscoveredAsset? @relation(fields: [discoveredAssetId], references: [id])
  discoveryJobId    String
  discoveryJob      DiscoveryJob     @relation(fields: [discoveryJobId], references: [id])
  kind              WatchAlertKind
  // Deliberately plain, not encrypted: same sensitivity tier as
  // DiscoveredAsset.openPorts/portDetails, which this app already stores
  // unencrypted (port/service facts, not the hostname itself — that stays
  // in DiscoveredAsset.valueEnc and is decrypted only at read time by
  // joining on discoveredAssetId, never duplicated into this row).
  summary       String // e.g. "Port 8080/tcp opened (nginx)" — never includes the hostname
  details       Json? // { before, after } port/service detail for whichever kind this is
  acknowledgedAt DateTime?
  acknowledgedBy String?
  createdAt      DateTime @default(now())

  @@index([engagementId])
  @@index([discoveredAssetId])
  @@index([discoveryJobId])
}

model Finding {
  id                     String        @id @default(uuid())
  testId                 String
  test                   Test          @relation(fields: [testId], references: [id])
  assetId                String
  asset                  Asset         @relation(fields: [assetId], references: [id])
  title                  String
  descriptionEnc         Json // EncryptedField
  severity               Severity
  cvssScore              Float?
  reproductionStepsEnc   Json? // EncryptedField
  remediationGuidanceEnc Json? // EncryptedField
  remediationEffort      RemediationEffort? // for the remediation roadmap: quick win vs long-term project
  status                 FindingStatus @default(OPEN)
  discoveredAt           DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  // AI-assisted triage (src/ai) — deliberately separate from the fields
  // above rather than writing into remediationGuidanceEnc/status directly.
  // A draft only ever becomes real guidance when a human PATCHes
  // acceptAiRemediationDraft: true (findings.routes.ts); nothing here is
  // ever read as ground truth on its own.
  aiRemediationDraftEnc     Json? // EncryptedField
  aiFalsePositiveLikelihood FalsePositiveLikelihood?
  aiTriageRationaleEnc      Json? // EncryptedField — shown to the reviewer alongside the draft, never hidden
  aiTriagedAt               DateTime?

  evidence Evidence[]
  retests  Retest[]

  @@index([testId])
  @@index([assetId])
}

// One row per uploaded evidence file (screenshot, log, pcap...).
// The file bytes live encrypted in object storage; this row holds the
// wrapped-DEK metadata needed to decrypt it, mirroring KeyRef but scoped to one file.
model Evidence {
  id               String   @id @default(uuid())
  findingId        String
  finding          Finding  @relation(fields: [findingId], references: [id])
  originalFilename String
  mimeType         String
  storageKey       String // path/key in object storage, ciphertext only
  iv               String
  authTag          String
  encryptedDataKey String
  kmsKeyId         String
  keyVersion       Int
  sizeBytes        Int
  uploadedBy       String
  uploadedAt       DateTime @default(now())

  // Malware check (src/integrations/virustotal.ts, fired async on upload).
  // sha256 is a hash of the plaintext bytes — not sensitive, safe to store
  // unencrypted, and needed to check the file's reputation without ever
  // decrypting/re-uploading the file itself to a third party.
  sha256            String?
  malwareStatus     MalwareStatus @default(PENDING)
  malwareDetections Int?
  malwareCheckedAt  DateTime?

  @@index([findingId])
}

model ComplianceCheck {
  id           String              @id @default(uuid())
  engagementId String
  engagement   Engagement          @relation(fields: [engagementId], references: [id])
  framework    ComplianceFramework
  controlId    String
  controlName  String
  status       ComplianceStatus
  notesEnc     Json? // EncryptedField
  createdAt    DateTime            @default(now())

  @@index([engagementId])
}

model Report {
  id               String     @id @default(uuid())
  engagementId     String
  engagement       Engagement @relation(fields: [engagementId], references: [id])
  type             ReportType
  version          Int        @default(1)
  storageKey       String // encrypted report file location
  iv               String
  authTag          String
  encryptedDataKey String
  kmsKeyId         String
  keyVersion       Int
  generatedAt      DateTime   @default(now())
  generatedBy      String

  @@index([engagementId])
}

model Retest {
  id         String       @id @default(uuid())
  findingId  String
  finding    Finding      @relation(fields: [findingId], references: [id])
  retestedBy String
  retestedAt DateTime     @default(now())
  result     RetestResult
  notesEnc   Json? // EncryptedField

  @@index([findingId])
}

model TrainingSession {
  id            String          @id @default(uuid())
  engagementId  String
  engagement    Engagement      @relation(fields: [engagementId], references: [id])
  topic         TrainingTopic
  customTopic   String? // used when topic = CUSTOM
  scheduledAt   DateTime
  status        TrainingStatus  @default(SCHEDULED)
  attendeeCount Int?
  notesEnc      Json? // EncryptedField — materials links, session notes
  createdAt     DateTime        @default(now())

  @@index([engagementId])
}

// Metadata ledger only — never raw key material. Lets rotation and audit
// track which CMK/version protects which record without ever holding a key.
model KeyRef {
  id           String     @id @default(uuid())
  purpose      KeyPurpose
  kmsKeyId     String
  keyVersion   Int
  resourceType String // e.g. "finding.descriptionEnc", "evidence"
  resourceId   String
  status       KeyStatus  @default(ACTIVE)
  createdAt    DateTime   @default(now())
  retiredAt    DateTime?

  @@index([resourceType, resourceId])
  @@index([status])
}

// Append-only by convention (no update/delete exposed via the API layer).
model AuditLog {
  id           String      @id @default(uuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  action       AuditAction
  resourceType String
  resourceId   String?
  engagementId String?
  ipAddress    String?
  userAgent    String?
  result       AuditResult
  timestamp    DateTime    @default(now())

  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([timestamp])
}

// --- Endpoint agent enrollment (src/modules/agents) -------------------------
// Devices are a persistent, engagement-independent presence — scoped to a
// Client directly, not to any one time-boxed Engagement (an agent installed
// today should keep reporting for as long as the relationship lasts, not
// get orphaned when whichever engagement happened to be active at install
// time closes). No X.509/TLS machinery anywhere here — nothing in this
// design does certificate-chain validation, so a real cert would just be
// unused attack surface. Ed25519 throughout instead: a small CA-signed
// credential recorded at enrollment (mostly for audit — the server verifies
// day-to-day requests against the device's own stored public key, not by
// re-checking the credential signature every time), and revocation is a
// boolean flag checked on every request, not a rotation scheme.

enum DeviceStatus {
  ACTIVE
  REVOKED
}

// Singleton row (there is exactly one, id fixed to "default") holding the
// app's own CA keypair — same KMS-wrapped custody pattern as every other
// key in this app (see src/crypto/envelope.ts): the private key seed is
// never persisted in plaintext, only ever decrypted in-memory for the
// instant it's needed to sign a device's enrollment credential.
model AgentCaKey {
  id                String   @id @default("default")
  publicKeyBase64   String // safe to expose — agents and this app both need it to verify signatures
  privateSeedEnc    Json // EncryptedField — 32-byte Ed25519 seed, system-key-wrapped (this is an app-global key, not a client's)
  createdAt         DateTime @default(now())
}

// A short-lived, single-use bearer credential a SECURITY_ADMIN generates in
// the dashboard and hands to whoever is installing the agent on a target
// machine. Stored only as a hash — the plaintext token is returned exactly
// once, at generation time, and never recoverable again. Redemption
// (POST /internal/agents/enroll) consumes it atomically: the same
// transaction that flips usedAt also creates the Device row, so a retried
// or raced request can never enroll two devices from one token.
model EnrollmentToken {
  id              String    @id @default(uuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id])
  tokenHash       String    @unique // sha256(token) — the plaintext token is never stored anywhere
  createdBy       String // User.id of the admin who generated it
  expiresAt       DateTime
  usedAt          DateTime?
  usedByDeviceId  String? // set once redeemed — traceability, not a relation (mirrors the plain-string-FK convention used elsewhere, e.g. ScanJob.triggeredById)
  createdAt       DateTime  @default(now())

  @@index([clientId])
  @@index([tokenHash])
}

model Device {
  id              String       @id @default(uuid())
  clientId        String
  client          Client       @relation(fields: [clientId], references: [id])
  name            String // hostname reported at enrollment
  platform        String // "windows" | "macos" | "linux"
  publicKeyBase64 String // the device's own Ed25519 public key — every subsequent request is verified against this, not against the CA-signed credential
  credentialSig   String // base64 Ed25519 signature the CA produced at enrollment — kept for audit/display, not re-verified per request
  status          DeviceStatus @default(ACTIVE)
  enrolledAt      DateTime     @default(now())
  lastCheckInAt   DateTime?
  osVersion       String?
  // Latest-only, not a history table — a real "show me the trend" view is
  // real v2 work (a separate append-only snapshot table), not something to
  // half-build here. EncryptedField, tenant-key-wrapped like everything
  // else client-scoped: installed software/OS version is a real attack-
  // surface disclosure about a client's actual machines, not metadata.
  lastInventoryEnc Json?
  revokedAt       DateTime?
  revokedBy       String? // User.id

  @@index([clientId])
  @@index([status])
}
